[Unit]
Description=AzerothCore Authentication Server
After=network-online.target mysql.service mariadb.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{ azerothcore_user }}
WorkingDirectory=/home/{{ azerothcore_user }}/{{ azerothcore_folder }}/{{ azerothcore_server }}/bin
ExecStart=/home/{{ azerothcore_user }}/{{ azerothcore_folder }}/{{ azerothcore_server }}/bin/authserver
Restart=always
RestartSec=5s
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=authserver

[Install]
WantedBy=multi-user.target
